GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AIRLY_API_KEY=
HOST=127.0.0.1
PORT=5000
LANGUAGE=ro
DEBUG_MODE=false
# Opt-in demo only: traffic and noise are generated, not measured.
ENABLE_SIMULATED_DATA=false
# Control Airly request usage; provider Retry-After overrides manual refresh.
AIR_REFRESH_MINUTES=360
AIRLY_MAX_MEASUREMENTS_PER_REFRESH=20
# Public OpenStreetMap fallback providers, in order.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
